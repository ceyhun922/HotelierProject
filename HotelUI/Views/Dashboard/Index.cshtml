<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<style>
    /* Apply the custom background gradient to the main container */
    .container-fluid {
        background: radial-gradient(1200px 600px at 10% 10%, rgba(168, 85, 247, .20), transparent 55%),
            radial-gradient(900px 520px at 90% 0%, rgba(56, 189, 248, .14), transparent 55%),
            linear-gradient(180deg, rgba(7, 6, 12, .92), rgba(10, 8, 18, .82));
        border-right: 1px solid rgba(255, 255, 255, .10);
        box-shadow: 0 30px 90px rgba(0, 0, 0, .55);
    }

    /* Card Styling */
    .card {
        background: rgba(255, 255, 255, 0.15);
        /* Light transparent background */
        backdrop-filter: blur(12px);
        /* Glassmorphism effect */
        border-radius: 15px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        /* Shadow for depth */
    }

    .card-body {
        padding: 20px;
    }

    .card-title {
        font-size: 20px;
        font-weight: bold;
    }

    /* Progress Bar Styling */
    .progress-bar {
        height: 7px;
    }

    .progress-bar.bg-primary {
        background-color: rgba(56, 189, 248, 0.8);
        /* Blue */
    }

    .progress-bar.bg-success {
        background-color: rgba(56, 189, 248, 0.6);
        /* Green */
    }

    .progress-bar.bg-warning {
        background-color: rgba(248, 113, 113, 0.6);
        /* Yellow/Orange */
    }

    /* Todo List */
    .todo-list {
        margin-top: 15px;
    }

    .todo-list input[type="checkbox"] {
        margin-right: 10px;
    }

    /* Table Styling */
    table {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        border-radius: 10px;
    }

    th,
    td {
        color: white;
        padding: 10px;
    }

    .table th {
        background: rgba(168, 85, 247, 0.3);
    }

    /* Button Styling */
    button {
        background-color: #a855f7;
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
    }
</style>

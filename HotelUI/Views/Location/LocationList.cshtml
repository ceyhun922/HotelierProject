@using DTOs.LocationDTOs
@model List<ResultLocationDto>
@{
    Layout = "_Layout";
    ViewBag.Title = "Locations";
    ViewBag.BodyClass = "list-theme";

    // Her karta farklı şehir ikonu ve renk atamak için
    var iconPool = new[] {
        ("fa-city",         "#7c6af7", "rgba(124,106,247,0.15)"),
        ("fa-building",     "#06b6d4", "rgba(6,182,212,0.15)"),
        ("fa-mountain-city","#f59e0b", "rgba(245,158,11,0.15)"),
        ("fa-bridge-water", "#10b981", "rgba(16,185,129,0.15)"),
        ("fa-landmark",     "#ec4899", "rgba(236,72,153,0.15)"),
        ("fa-tower-observation","#8b5cf6","rgba(139,92,246,0.15)"),
        ("fa-tree-city",    "#14b8a6", "rgba(20,184,166,0.15)"),
        ("fa-house-flag",   "#f97316", "rgba(249,115,22,0.15)"),
    };
}

@section Styles {
<style>
@@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

:root {
    --bg:          #0b0c10;
    --surface:     rgba(255,255,255,0.04);
    --border:      rgba(255,255,255,0.07);
    --border2:     rgba(255,255,255,0.13);
    --accent:      #7c6af7;
    --accent2:     #a78bfa;
    --accent-glow: rgba(124,106,247,0.28);
    --red:         #ef4444;
    --red-dim:     rgba(239,68,68,0.10);
    --text:        #e8eaf0;
    --text2:       #9ca3af;
    --text3:       #6b7280;
    --radius:      20px;
    --radius-sm:   10px;
    --shadow:      0 8px 40px rgba(0,0,0,0.5);
    --font-d:      'Sora', sans-serif;
    --font-b:      'DM Sans', sans-serif;
    --tr:          0.24s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body.list-theme {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-b);
    min-height: 100vh;
    background-image:
        radial-gradient(ellipse 70% 40% at 10% 0%,  rgba(124,106,247,0.13) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 90% 100%, rgba(124,106,247,0.07) 0%, transparent 60%);
}

.wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 44px 28px 80px;
}

/* ─── HERO ─── */
.hero {
    display: flex; align-items: flex-start;
    justify-content: space-between;
    gap: 20px; margin-bottom: 36px; flex-wrap: wrap;
}
.hero h1 {
    font-family: var(--font-d);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 800; letter-spacing: -0.04em;
    background: linear-gradient(135deg, #fff 30%, var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
}
.hero p { color: var(--text2); font-size: .875rem; line-height: 1.65; max-width: 460px; }
.hero-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.chip {
    padding: 6px 16px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border2);
    font-size: .74rem; font-weight: 600;
    color: var(--accent2); letter-spacing: .05em; white-space: nowrap;
}

/* ─── GLASS CARD ─── */
.glass-card {
    background: rgba(255,255,255,0.025);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,0.05);
    animation: fadeUp .5s ease both;
    overflow: hidden;
}
@@keyframes fadeUp {
    from { opacity:0; transform:translateY(22px); }
    to   { opacity:1; transform:translateY(0); }
}
.card-inner { padding: 30px; }

/* ─── TOOLBAR ─── */
.list-toolbar {
    display: flex; align-items: center;
    gap: 14px; margin-bottom: 30px; flex-wrap: wrap;
}
.search-wrap { position: relative; flex: 1; min-width: 220px; }
.search-icon {
    position: absolute; left: 14px; top: 50%;
    transform: translateY(-50%);
    color: var(--text3); font-size: .78rem; pointer-events: none;
}
.input {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text); font-family: var(--font-b); font-size: .875rem;
    padding: 11px 14px 11px 40px; outline: none;
    transition: border-color var(--tr), box-shadow var(--tr), background var(--tr);
}
.input:focus {
    border-color: var(--accent);
    background: rgba(124,106,247,0.06);
    box-shadow: 0 0 0 3px rgba(124,106,247,0.18);
}
.input::placeholder { color: var(--text3); }

/* ─── GRID ─── */
.loc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
}

/* ─── LOCATION CARD ─── */
.loc-card {
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.03);
    position: relative;
    transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
    animation: cardIn .45s ease both;
}
.loc-card:hover {
    transform: translateY(-6px);
    border-color: var(--card-color, var(--accent));
    box-shadow:
        0 24px 60px rgba(0,0,0,0.45),
        0 0 0 1px rgba(255,255,255,0.06),
        0 0 40px var(--card-glow, var(--accent-glow));
}
.loc-card.hidden { display: none; }

@@keyframes cardIn {
    from { opacity:0; transform:translateY(20px) scale(.96); }
    to   { opacity:1; transform:translateY(0)    scale(1); }
}

/* ── BIG ICON HEADER ── */
.card-hero {
    position: relative;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--card-bg, rgba(124,106,247,0.12));
    flex-shrink: 0;
}

/* noise texture overlay */
.card-hero::before {
    content: '';
    position: absolute; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    background-size: 180px;
    opacity: .6;
    pointer-events: none;
}

/* subtle radial glow behind icon */
.card-hero::after {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 70% 70% at 50% 60%, var(--card-glow, var(--accent-glow)) 0%, transparent 70%);
    pointer-events: none;
}

.big-icon {
    font-size: 5.5rem;
    color: var(--card-color, var(--accent2));
    opacity: .22;
    position: absolute;
    bottom: -12px; right: -10px;
    transition: opacity var(--tr), transform var(--tr);
    z-index: 1;
    line-height: 1;
}
.loc-card:hover .big-icon {
    opacity: .35;
    transform: scale(1.08) rotate(-5deg);
}

.center-icon {
    font-size: 2.4rem;
    color: var(--card-color, var(--accent2));
    z-index: 2;
    position: relative;
    filter: drop-shadow(0 0 18px var(--card-glow, var(--accent-glow)));
    transition: transform var(--tr), filter var(--tr);
}
.loc-card:hover .center-icon {
    transform: scale(1.15) translateY(-3px);
    filter: drop-shadow(0 0 28px var(--card-glow, var(--accent-glow)));
}

/* ID badge hero içinde */
.hero-id {
    position: absolute; top: 12px; left: 14px; z-index: 3;
    display: inline-flex; align-items: center;
    padding: 3px 9px; border-radius: 6px;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.1);
    font-size: .68rem; font-weight: 600; color: rgba(255,255,255,.55);
    font-family: 'Courier New', monospace;
}

/* sağ üst köşe dekoratif dot cluster */
.dot-cluster {
    position: absolute; top: 10px; right: 12px; z-index: 3;
    display: flex; gap: 4px;
}
.dot-cluster span {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--card-color, var(--accent));
    opacity: .5;
}
.dot-cluster span:nth-child(2) { opacity: .3; }
.dot-cluster span:nth-child(3) { opacity: .15; }

/* ── CARD BODY ── */
.card-body {
    padding: 18px 20px 14px;
    flex: 1; display: flex; flex-direction: column; gap: 10px;
}
.card-name {
    font-family: var(--font-d);
    font-size: 1.15rem; font-weight: 700;
    color: var(--text); letter-spacing: -.02em;
    line-height: 1.25;
}

/* MAP INFO ROW */
.map-row {
    display: flex; flex-direction: column; gap: 5px;
}
.map-item {
    display: flex; align-items: center; gap: 8px;
    font-size: .76rem; color: var(--text2);
    padding: 5px 8px;
    border-radius: 7px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    transition: background var(--tr), border-color var(--tr);
}
.loc-card:hover .map-item {
    background: rgba(255,255,255,0.05);
    border-color: rgba(255,255,255,0.09);
}
.map-item i {
    font-size: .72rem;
    color: var(--card-color, var(--accent2));
    width: 14px; text-align: center; flex-shrink: 0;
}
.map-item span { font-family: 'DM Mono', 'Courier New', monospace; letter-spacing: .02em; }
.map-label { font-size: .65rem; color: var(--text3); margin-left: auto; }

/* maps link */
.maps-link {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .72rem; font-weight: 600;
    color: var(--card-color, var(--accent2));
    text-decoration: none;
    padding: 4px 0;
    opacity: .7;
    transition: opacity var(--tr);
}
.maps-link:hover { opacity: 1; text-decoration: underline; }

/* ── CARD FOOTER ── */
.card-footer {
    padding: 10px 16px 14px;
    border-top: 1px solid var(--border);
    display: flex; gap: 8px;
}
.act-btn {
    flex: 1; height: 36px; border-radius: 9px;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    font-size: .79rem; font-weight: 600; font-family: var(--font-b);
    text-decoration: none; border: 1px solid var(--border);
    cursor: pointer; transition: all var(--tr);
}
.act-edit {
    background: rgba(255,255,255,0.04);
    color: var(--card-color, var(--accent2));
    border-color: rgba(255,255,255,0.08);
}
.act-edit:hover {
    background: var(--card-bg, rgba(124,106,247,0.12));
    border-color: var(--card-color, var(--accent));
    box-shadow: 0 4px 16px var(--card-glow, var(--accent-glow));
    transform: translateY(-1px);
}
.act-delete {
    flex: 0 0 36px;
    background: var(--red-dim); color: var(--red);
    border-color: rgba(239,68,68,0.2);
}
.act-delete:hover {
    background: rgba(239,68,68,0.22); border-color: var(--red);
    box-shadow: 0 4px 14px rgba(239,68,68,.2); transform: translateY(-1px);
}

/* ─── EMPTY ─── */
.empty-state {
    grid-column: 1/-1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 14px; padding: 80px 20px;
    color: var(--text3); text-align: center;
}
.empty-state i { font-size: 3.5rem; opacity: .18; }
.empty-state p  { font-size: .92rem; }

/* ─── LIST FOOTER ─── */
.list-footer {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 26px; flex-wrap: wrap; gap: 12px;
}
.hint { font-size: .75rem; color: var(--text3); }

/* ─── BUTTONS ─── */
.btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 20px; border-radius: var(--radius-sm);
    font-family: var(--font-b); font-size: .85rem; font-weight: 600;
    cursor: pointer; border: none; transition: all var(--tr);
    text-decoration: none; white-space: nowrap;
}
.btn-primary {
    background: linear-gradient(135deg, var(--accent), #9b84f8);
    color: #fff; box-shadow: 0 2px 16px var(--accent-glow);
}
.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 28px var(--accent-glow);
    filter: brightness(1.1); color: #fff; text-decoration: none;
}

@@media (max-width: 640px) {
    .card-inner  { padding: 18px 14px; }
    .hero h1     { font-size: 1.4rem; }
    .list-toolbar { flex-direction: column; align-items: stretch; }
    .loc-grid    { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .card-hero   { height: 130px; }
    .big-icon    { font-size: 4rem; }
    .center-icon { font-size: 2rem; }
}
@@media (max-width: 400px) {
    .loc-grid { grid-template-columns: 1fr; }
}
</style>
}

<div class="wrap">

    <!-- HERO -->
    <div class="hero">
        <div>
            <h1>Location • List</h1>
            <p>Tüm konumları görüntüle, düzenle veya sil. Canlı arama desteklenir.</p>
        </div>
        <div class="hero-right">
            <div class="chip">@(Model?.Count ?? 0) Konum</div>
            <a asp-action="CreateLocation" asp-controller="Location" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Yeni Ekle
            </a>
        </div>
    </div>

    <div class="glass-card">
        <div class="card-inner">

            <!-- TOOLBAR -->
            <div class="list-toolbar">
                <div class="search-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="searchInput" class="input" placeholder="Konum ara..." />
                </div>
            </div>

            <!-- GRID -->
            <div class="loc-grid" id="locGrid">

                @if (Model != null && Model.Count > 0)
                {
                    int idx = 0;
                    @foreach (var item in Model)
                    {
                        var (icon, color, glow) = iconPool[idx % iconPool.Length];
                        idx++;

                        // Sahte koordinat — gerçek veriye bağlamak istersen modele lat/lng ekle
                        var fakeLat  = (41.0 + (idx * 0.37 % 8)).ToString("F4");
                        var fakeLng  = (28.9 + (idx * 0.53 % 6)).ToString("F4");
                        var mapsUrl  = $"https://www.google.com/maps/search/?api=1&query={fakeLat},{fakeLng}";

                        <div class="loc-card"
                             data-name="@item.Name?.ToLower()"
                             style="--card-color:@color; --card-glow:@glow; --card-bg:@(glow.Replace("0.15","0.10")); animation-delay:@(idx * 60)ms">

                            <!-- HERO IMAGE AREA -->
                            <div class="card-hero">
                                <span class="hero-id">#@item.Id</span>

                                <div class="dot-cluster">
                                    <span></span><span></span><span></span>
                                </div>

                                <!-- büyük arka plan ikonu -->
                                <i class="fa-solid @icon big-icon"></i>

                                <!-- orta ikon -->
                                <i class="fa-solid @icon center-icon"></i>
                            </div>

                            <!-- BODY -->
                            <div class="card-body">
                                <div class="card-name">@item.Name</div>

                                <!-- MAP INFO -->
                                <div class="map-row">
                                    <div class="map-item">
                                        <i class="fa-solid fa-up-down"></i>
                                        <span>@fakeLat° N</span>
                                        <span class="map-label">Enlem</span>
                                    </div>
                                    <div class="map-item">
                                        <i class="fa-solid fa-left-right"></i>
                                        <span>@fakeLng° E</span>
                                        <span class="map-label">Boylam</span>
                                    </div>
                                </div>

                                <a href="@mapsUrl" target="_blank" rel="noopener" class="maps-link">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    Google Maps'te Aç
                                </a>
                            </div>

                            <!-- FOOTER -->
                            <div class="card-footer">
                                <a asp-action="UpdateLocation"
                                   asp-controller="Location"
                                   asp-route-id="@item.Id"
                                   class="act-btn act-edit">
                                    <i class="fa-solid fa-pen"></i> Düzenle
                                </a>
                                <a asp-action="DeleteLocation"
                                   asp-controller="Location"
                                   asp-route-id="@item.Id"
                                   class="act-btn act-delete"
                                   onclick="return confirm('Bu konumu silmek istediğinize emin misiniz?')">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-location-dot"></i>
                        <p>Henüz konum eklenmedi.</p>
                        <a asp-action="CreateLocation" asp-controller="Location"
                           class="btn btn-primary" style="margin-top:4px;">
                            İlk Konumu Ekle
                        </a>
                    </div>
                }

            </div>

            <!-- FOOTER -->
            <div class="list-footer">
                <div class="hint" id="resultCount">@(Model?.Count ?? 0) adet kayıt gösteriliyor.</div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    "use strict";

    const searchInput = document.getElementById("searchInput");
    const cards       = document.querySelectorAll("#locGrid .loc-card");
    const resultCount = document.getElementById("resultCount");

    searchInput?.addEventListener("input", () => {
        const q = searchInput.value.toLowerCase().trim();
        let visible = 0;

        cards.forEach(card => {
            const match = !q || (card.dataset.name || "").includes(q);
            card.classList.toggle("hidden", !match);
            if (match) visible++;
        });

        if (resultCount) resultCount.textContent = `${visible} adet kayıt gösteriliyor.`;

        const ex = document.getElementById("noResult");
        if (visible === 0 && cards.length > 0) {
            if (!ex) {
                const el = document.createElement("div");
                el.id = "noResult";
                el.className = "empty-state";
                el.style.gridColumn = "1/-1";
                el.innerHTML = `<i class="fa-solid fa-magnifying-glass"></i>
                                <p>Arama kriterinize uygun konum bulunamadı.</p>`;
                document.getElementById("locGrid").appendChild(el);
            }
        } else if (ex) { ex.remove(); }
    });

})();
</script>
}

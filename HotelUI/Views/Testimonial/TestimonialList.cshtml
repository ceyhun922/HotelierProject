@using DTOs.TestimonialDTOs
@model List<ResultTestimonialDto>
@{
    Layout = "_Layout";
    ViewBag.Title = "Testimonials";
    ViewBag.BodyClass = "list-theme-4";
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

:root {
    --bg:          #0b0c10;
    --surface:     rgba(255,255,255,0.04);
    --border:      rgba(255,255,255,0.07);
    --border2:     rgba(255,255,255,0.13);
    --accent:      #7c6af7;
    --accent2:     #a78bfa;
    --accent-glow: rgba(124,106,247,0.25);
    --green:       #22c55e;
    --green-dim:   rgba(34,197,94,0.12);
    --red:         #ef4444;
    --red-dim:     rgba(239,68,68,0.10);
    --text:        #e8eaf0;
    --text2:       #9ca3af;
    --text3:       #6b7280;
    --radius:      18px;
    --radius-sm:   10px;
    --shadow:      0 8px 40px rgba(0,0,0,0.5);
    --font-d:      'Sora', sans-serif;
    --font-b:      'DM Sans', sans-serif;
    --tr:          0.22s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body.list-theme-4 {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-b);
    min-height: 100vh;
    background-image:
        radial-gradient(ellipse 70% 40% at 10% 0%,  rgba(124,106,247,0.12) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 90% 100%, rgba(124,106,247,0.06) 0%, transparent 60%);
}

.wrap { max-width: 1280px; margin: 0 auto; padding: 44px 28px 72px; }

/* ─── HERO ─── */
.hero {
    display: flex; align-items: flex-start;
    justify-content: space-between;
    gap: 20px; margin-bottom: 32px; flex-wrap: wrap;
}
.hero h1 {
    font-family: var(--font-d);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700; letter-spacing: -0.03em;
    background: linear-gradient(135deg, #fff 40%, var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
}
.hero p { color: var(--text2); font-size: .875rem; line-height: 1.6; max-width: 460px; }
.hero-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.chip {
    padding: 6px 16px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border2);
    font-size: .74rem; font-weight: 600;
    color: var(--accent2); letter-spacing: .05em; white-space: nowrap;
}

/* ─── GLASS CARD ─── */
.glass-card {
    background: rgba(255,255,255,0.025);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,0.05);
    animation: fadeUp .45s ease both;
}
@@keyframes fadeUp {
    from { opacity:0; transform:translateY(20px); }
    to   { opacity:1; transform:translateY(0); }
}
.card-inner { padding: 28px; }

/* ─── TOOLBAR ─── */
.list-toolbar {
    display: flex; align-items: center;
    gap: 14px; margin-bottom: 28px; flex-wrap: wrap;
}
.search-wrap { position: relative; flex: 1; min-width: 220px; }
.search-icon {
    position: absolute; left: 14px; top: 50%;
    transform: translateY(-50%);
    color: var(--text3); font-size: .78rem; pointer-events: none;
}
.s-input {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text); font-family: var(--font-b); font-size: .875rem;
    padding: 10px 14px 10px 38px; outline: none;
    transition: border-color var(--tr), box-shadow var(--tr), background var(--tr);
}
.s-input:focus {
    border-color: var(--accent);
    background: rgba(124,106,247,0.06);
    box-shadow: 0 0 0 3px rgba(124,106,247,0.18);
}
.s-input::placeholder { color: var(--text3); }

.filter-group {
    display: flex; gap: 6px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 999px; padding: 4px;
}
.filter-btn {
    padding: 5px 16px; border-radius: 999px; border: none;
    background: transparent; color: var(--text2);
    font-family: var(--font-b); font-size: .78rem; font-weight: 500;
    cursor: pointer;
    transition: background var(--tr), color var(--tr), box-shadow var(--tr);
    white-space: nowrap;
}
.filter-btn:hover { color: var(--text); }
.filter-btn.active { background: var(--accent); color: #fff; box-shadow: 0 0 14px var(--accent-glow); }

/* ─── GRID — 2 sütun yatay ─── */
.testimonial-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(520px, 1fr));
    gap: 16px;
}

/* ─── TESTIMONIAL CARD — YATAY ─── */
.t-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.03);
    overflow: hidden;
    position: relative;
    transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
    animation: cardIn .4s ease both;
    min-height: 160px;
}
.t-card::before {
    content: '';
    position: absolute; inset: 0; border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(124,106,247,0.06) 0%, transparent 55%);
    opacity: 0; transition: opacity var(--tr); pointer-events: none;
}
.t-card:hover {
    transform: translateY(-4px);
    border-color: rgba(124,106,247,0.35);
    box-shadow: 0 16px 48px rgba(0,0,0,0.4), 0 0 0 1px rgba(124,106,247,0.15);
}
.t-card:hover::before { opacity: 1; }
.t-card.hidden { display: none; }

@@keyframes cardIn {
    from { opacity:0; transform:translateY(14px) scale(.98); }
    to   { opacity:1; transform:translateY(0) scale(1); }
}

/* ── SOL — KULLANICI TARAFLARI ── */
.t-user {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 20px 12px;
    background: rgba(124,106,247,0.06);
    border-right: 1px solid var(--border);
    position: relative;
    overflow: hidden;
}

/* dekoratif arka plan */
.t-user::before {
    content: '\201C';
    position: absolute;
    font-family: Georgia, serif;
    font-size: 8rem; font-weight: 900;
    color: var(--accent);
    opacity: .06;
    top: -18px; left: -8px;
    line-height: 1;
    pointer-events: none;
}

/* avatar */
.t-avatar {
    width: 56px; height: 56px; border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(124,106,247,0.35);
    box-shadow: 0 0 0 3px rgba(124,106,247,0.1);
    flex-shrink: 0;
    transition: transform var(--tr), box-shadow var(--tr);
}
.t-card:hover .t-avatar {
    transform: scale(1.06);
    box-shadow: 0 0 0 3px rgba(124,106,247,0.3), 0 0 16px var(--accent-glow);
}
.t-avatar img { width:100%; height:100%; object-fit:cover; }
.t-avatar-placeholder {
    width:100%; height:100%;
    display:flex; align-items:center; justify-content:center;
    background: linear-gradient(135deg, rgba(124,106,247,0.25), rgba(124,106,247,0.08));
    font-family: var(--font-d); font-size: 1.3rem; font-weight: 700;
    color: var(--accent2);
}

/* status dot */
.t-status {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 8px; border-radius: 999px;
    font-size: .62rem; font-weight: 600; letter-spacing: .04em;
}
.t-status.on  { background: var(--green-dim); border:1px solid rgba(34,197,94,.25); color:var(--green); }
.t-status.off { background: rgba(255,255,255,.04); border:1px solid var(--border); color:var(--text3); }
.dot { width:5px; height:5px; border-radius:50%; flex-shrink:0; }
.dot.g { background:var(--green); box-shadow:0 0 4px var(--green); animation:blink 2s infinite; }
.dot.x { background:var(--text3); }
@@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

/* id */
.t-id {
    font-size: .6rem; color: var(--text3);
    font-family: 'Courier New', monospace;
}

/* ── SAĞ — İÇERİK ── */
.t-content {
    display: flex;
    flex-direction: column;
    padding: 18px 20px 14px;
    gap: 10px;
    min-width: 0;
}

/* büyük tırnak ikonu */
.quote-icon {
    font-size: 1.4rem;
    color: var(--accent);
    opacity: .5;
    line-height: 1;
    font-family: Georgia, serif;
    margin-bottom: -4px;
}

/* yorum metni */
.t-message {
    font-size: .875rem;
    color: var(--text2);
    line-height: 1.65;
    font-style: italic;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
}

/* alt kısım: isim + unvan + actions */
.t-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
}
.t-meta { min-width: 0; }
.t-name {
    font-family: var(--font-d);
    font-size: .88rem; font-weight: 700;
    color: var(--text); letter-spacing: -.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.t-title {
    font-size: .72rem; color: var(--accent2);
    font-weight: 500; margin-top: 2px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* star rating dekoratif */
.t-stars {
    display: flex; gap: 2px;
    font-size: .65rem;
    color: #f59e0b;
    margin-top: 3px;
}

.t-actions { display: flex; gap: 6px; flex-shrink: 0; }
.act-btn {
    height: 30px; padding: 0 12px;
    border-radius: 7px;
    display: inline-flex; align-items: center; justify-content: center; gap: 5px;
    font-size: .72rem; font-weight: 600; font-family: var(--font-b);
    text-decoration: none; border: 1px solid var(--border);
    cursor: pointer; transition: all var(--tr);
    background: rgba(255,255,255,.03); color: var(--text2);
}
.act-edit { color: var(--accent2); border-color: rgba(124,106,247,.2); background: rgba(124,106,247,.07); }
.act-edit:hover { background: rgba(124,106,247,.18); border-color:var(--accent); transform:translateY(-1px); box-shadow:0 4px 12px var(--accent-glow); color:var(--accent2); text-decoration:none; }
.act-del  { width:30px; padding:0; background: var(--red-dim); color:var(--red); border-color:rgba(239,68,68,.2); }
.act-del:hover { background:rgba(239,68,68,.2); border-color:var(--red); transform:translateY(-1px); box-shadow:0 4px 12px rgba(239,68,68,.18); }

/* ─── EMPTY ─── */
.empty-state {
    grid-column: 1/-1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 12px; padding: 72px 20px;
    color: var(--text3); text-align: center;
}
.empty-state i { font-size: 3rem; opacity:.2; }
.empty-state p  { font-size: .9rem; }

/* ─── FOOTER ─── */
.list-footer {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 24px; flex-wrap: wrap; gap: 12px;
}
.hint { font-size: .75rem; color: var(--text3); }
.footer-stats { display:flex; gap:14px; }
.stat-pill { display:flex; align-items:center; gap:6px; font-size:.78rem; color:var(--text2); }
.stat-pill strong { color: var(--text); }

/* ─── BUTTONS ─── */
.btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 18px; border-radius: var(--radius-sm);
    font-family: var(--font-b); font-size: .85rem; font-weight: 600;
    cursor: pointer; border: none; transition: all var(--tr);
    text-decoration: none; white-space: nowrap;
}
.btn-primary {
    background: linear-gradient(135deg, var(--accent), #9b84f8);
    color: #fff; box-shadow: 0 2px 16px var(--accent-glow);
}
.btn-primary:hover {
    transform: translateY(-1px); box-shadow: 0 6px 28px var(--accent-glow);
    filter: brightness(1.1); color:#fff; text-decoration:none;
}

@@media (max-width: 700px) {
    .testimonial-grid { grid-template-columns: 1fr; }
    .t-card { grid-template-columns: 80px 1fr; min-height: 140px; }
    .card-inner { padding: 16px 12px; }
    .hero h1 { font-size: 1.35rem; }
    .list-toolbar { flex-direction: column; align-items: stretch; }
    .filter-group { justify-content: center; }
}
</style>

<div class="wrap">

    <!-- HERO -->
    <div class="hero">
        <div>
            <h1>Testimonial • List</h1>
            <p>Tüm referansları görüntüle, düzenle veya sil. Canlı arama ve filtre desteklenir.</p>
        </div>
        <div class="hero-right">
            <div class="chip">@(Model?.Count ?? 0) Referans</div>
            <a asp-action="CreateTestimonial" asp-controller="Testimonial" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Yeni Ekle
            </a>
        </div>
    </div>

    <div class="glass-card">
        <div class="card-inner">

            <!-- TOOLBAR -->
            <div class="list-toolbar">
                <div class="search-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="searchInput" class="s-input" placeholder="İsim, ünvan veya yorum ara..." />
                </div>
                <div class="filter-group">
                    <button class="filter-btn active" data-filter="all">Tümü</button>
                    <button class="filter-btn" data-filter="active">Aktif</button>
                    <button class="filter-btn" data-filter="passive">Pasif</button>
                </div>
            </div>

            <!-- GRID -->
            <div class="testimonial-grid" id="tGrid">

                @if (Model != null && Model.Count > 0)
                {
                    int idx = 0;
                    @foreach (var item in Model)
                    {
                        idx++;
                        var hasImg   = !string.IsNullOrEmpty(item.ImageUrl);
                        var initials = string.Join("",
                            (item.FullName ?? "?")
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2).Select(w => w[0])).ToUpper();

                        <div class="t-card"
                             data-status="@(item.Status ? "active" : "passive")"
                             data-name="@item.FullName?.ToLower()"
                             data-title="@item.Title?.ToLower()"
                             data-msg="@item.Message?.ToLower()"
                             style="animation-delay:@(idx * 50)ms">

                            <!-- SOL — KULLANICI -->
                            <div class="t-user">
                                <div class="t-avatar">
                                    @if (hasImg)
                                    {
                                        <img src="@item.ImageUrl" alt="@item.FullName" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="t-avatar-placeholder">@initials</div>
                                    }
                                </div>

                                <div class="t-status @(item.Status ? "on" : "off")">
                                    <span class="dot @(item.Status ? "g" : "x")"></span>
                                    @(item.Status ? "Aktif" : "Pasif")
                                </div>

                                <div class="t-id">#@item.Id</div>
                            </div>

                            <!-- SAĞ — İÇERİK -->
                            <div class="t-content">
                                <div class="quote-icon">&ldquo;</div>

                                <div class="t-message">
                                    @(string.IsNullOrWhiteSpace(item.Message) ? "Yorum girilmemiş." : item.Message)
                                </div>

                                <div class="t-bottom">
                                    <div class="t-meta">
                                        <div class="t-name">@(item.FullName ?? "—")</div>
                                        <div class="t-title">@(item.Title ?? "—")</div>
                                        <div class="t-stars">
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                            <i class="fa-solid fa-star"></i>
                                        </div>
                                    </div>
                                    <div class="t-actions">
                                        <a asp-action="UpdateTestimonial"
                                           asp-controller="Testimonial"
                                           asp-route-id="@item.Id"
                                           class="act-btn act-edit">
                                            <i class="fa-solid fa-pen"></i> Düzenle
                                        </a>
                                        <a asp-action="DeleteTestimonial"
                                           asp-controller="Testimonial"
                                           asp-route-id="@item.Id"
                                           class="act-btn act-del"
                                           onclick="return confirm('Bu referansı silmek istediğinize emin misiniz?')">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-comment-slash"></i>
                        <p>Henüz referans eklenmedi.</p>
                        <a asp-action="CreateTestimonial" asp-controller="Testimonial"
                           class="btn btn-primary" style="margin-top:4px;">
                            İlk Referansı Ekle
                        </a>
                    </div>
                }

            </div>

            <!-- LIST FOOTER -->
            <div class="list-footer">
                <div class="hint" id="resultCount">@(Model?.Count ?? 0) referans gösteriliyor.</div>
                <div class="footer-stats">
                    <div class="stat-pill">
                        <span class="dot g"></span>
                        Aktif: <strong>@(Model?.Count(x => x.Status) ?? 0)</strong>
                    </div>
                    <div class="stat-pill">
                        <span class="dot x"></span>
                        Pasif: <strong>@(Model?.Count(x => !x.Status) ?? 0)</strong>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
(function () {
    "use strict";

    const searchInput = document.getElementById("searchInput");
    const filterBtns  = document.querySelectorAll(".filter-btn");
    const cards       = document.querySelectorAll("#tGrid .t-card");
    const resultCount = document.getElementById("resultCount");
    let currentFilter = "all";

    searchInput?.addEventListener("input", apply);

    filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            filterBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            currentFilter = btn.dataset.filter;
            apply();
        });
    });

    function apply() {
        const q = (searchInput?.value || "").toLowerCase().trim();
        let visible = 0;

        cards.forEach(card => {
            const matchSearch =
                !q ||
                (card.dataset.name  || "").includes(q) ||
                (card.dataset.title || "").includes(q) ||
                (card.dataset.msg   || "").includes(q);

            const matchFilter =
                currentFilter === "all" ||
                (currentFilter === "active"  && card.dataset.status === "active") ||
                (currentFilter === "passive" && card.dataset.status === "passive");

            const show = matchSearch && matchFilter;
            card.classList.toggle("hidden", !show);
            if (show) visible++;
        });

        if (resultCount) resultCount.textContent = `${visible} referans gösteriliyor.`;

        const ex = document.getElementById("noResult");
        if (visible === 0 && cards.length > 0) {
            if (!ex) {
                const el = document.createElement("div");
                el.id = "noResult"; el.className = "empty-state";
                el.style.gridColumn = "1/-1";
                el.innerHTML = `<i class="fa-solid fa-magnifying-glass"></i>
                                <p>Arama kriterinize uygun referans bulunamadı.</p>`;
                document.getElementById("tGrid").appendChild(el);
            }
        } else if (ex) { ex.remove(); }
    }

})();
</script>

@using DTOs.BookingDTOs
@model List<ResultBookingDto>

@{
    Layout = "_Layout";
    var count = 1;
}

<style>
    :root {
        --bg1: #070A18;
        --bg2: #120A2A;
        --glass: rgba(255,255,255,0.06);
        --glass2: rgba(255,255,255,0.09);
        --stroke: rgba(255,255,255,0.12);
        --stroke2: rgba(255,255,255,0.18);

        --text: rgba(255,255,255,0.92);
        --muted: rgba(255,255,255,0.65);

        --primary: #ffb200;
        --primary2: #ff7a00;

        --danger: #ff3b3b;
        --danger2: #ff0048;

        --purpleGlow: rgba(160, 90, 255, 0.35);
        --pinkGlow: rgba(255, 60, 190, 0.25);
        --blueGlow: rgba(60, 180, 255, 0.18);
    }

    body {
        background: radial-gradient(circle at 20% 10%, rgba(130, 50, 255, 0.20), transparent 60%),
                    radial-gradient(circle at 80% 30%, rgba(255, 80, 200, 0.16), transparent 60%),
                    radial-gradient(circle at 60% 80%, rgba(80, 170, 255, 0.14), transparent 60%),
                    linear-gradient(180deg, var(--bg1), var(--bg2));
        color: var(--text);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
        min-height: 100vh;
    }

    /* Background grid overlay */
    .nebula-grid {
        position: fixed;
        inset: 0;
        background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
                          linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
        background-size: 70px 70px;
        opacity: 0.15;
        pointer-events: none;
        z-index: 0;
    }

    /* Floating orbs */
    .orb {
        position: fixed;
        border-radius: 999px;
        filter: blur(50px);
        opacity: 0.55;
        z-index: 0;
        pointer-events: none;
        animation: floatOrb 10s ease-in-out infinite;
    }

    .orb.orb1 {
        width: 280px;
        height: 280px;
        top: 120px;
        left: 80px;
        background: rgba(150, 70, 255, 0.55);
    }

    .orb.orb2 {
        width: 340px;
        height: 340px;
        bottom: 80px;
        right: 120px;
        background: rgba(255, 80, 210, 0.40);
        animation-delay: 2s;
    }

    .orb.orb3 {
        width: 240px;
        height: 240px;
        top: 55%;
        left: 55%;
        background: rgba(80, 190, 255, 0.35);
        animation-delay: 4s;
    }

    @@keyframes floatOrb {
        0%,100% { transform: translateY(0px) translateX(0px); }
        50% { transform: translateY(-20px) translateX(12px); }
    }

    /* Main glass card */
    .glass-card {
        position: relative;
        z-index: 2;
        background: linear-gradient(145deg, rgba(255,255,255,0.08), rgba(255,255,255,0.03));
        border: 1px solid var(--stroke);
        border-radius: 22px;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: 0 18px 60px rgba(0,0,0,0.55);
        padding: 26px;
        overflow: hidden;
    }

    .glass-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top left, rgba(160,90,255,0.18), transparent 60%),
                    radial-gradient(circle at bottom right, rgba(255,80,200,0.12), transparent 60%);
        z-index: 0;
        pointer-events: none;
    }

    .glass-card > * {
        position: relative;
        z-index: 2;
    }

    .page-title {
        font-size: 22px;
        font-weight: 800;
        letter-spacing: 0.3px;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 22px;
    }

    /* Table */
    .premium-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .premium-table thead th {
        font-size: 12px;
        color: rgba(255,255,255,0.75);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        padding: 12px 14px;
        border: none !important;
        background: transparent !important;
    }

    .premium-table tbody tr {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 18px;
        overflow: hidden;
        transition: 0.25s ease;
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    }

    .premium-table tbody tr:hover {
        transform: translateY(-3px);
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(160,90,255,0.35);
        box-shadow: 0 18px 50px rgba(160,90,255,0.15);
    }

    .premium-table tbody td {
        padding: 14px 14px;
        border: none !important;
        font-size: 13px;
        color: rgba(255,255,255,0.90);
        vertical-align: middle;
    }

    /* Rounded row effect */
    .premium-table tbody tr td:first-child {
        border-top-left-radius: 18px;
        border-bottom-left-radius: 18px;
        font-weight: 800;
        color: var(--primary);
    }

    .premium-table tbody tr td:last-child {
        border-top-right-radius: 18px;
        border-bottom-right-radius: 18px;
    }

    /* Message cell */
    .message-box {
        max-width: 220px;
        max-height: 60px;
        overflow-y: auto;
        padding: 10px;
        border-radius: 14px;
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(255,255,255,0.10);
        color: rgba(255,255,255,0.80);
        font-size: 12px;
        line-height: 1.4;
    }

    .message-box::-webkit-scrollbar {
        width: 6px;
    }

    .message-box::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.25);
        border-radius: 99px;
    }

    /* Action buttons */
    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.06);
        color: rgba(255,255,255,0.85);
        transition: 0.2s ease;
        text-decoration: none;
        box-shadow: 0 10px 25px rgba(0,0,0,0.35);
    }

    .action-btn:hover {
        transform: translateY(-2px);
        border: 1px solid rgba(255,255,255,0.25);
        background: rgba(255,255,255,0.12);
    }

    .action-btn.edit:hover {
        box-shadow: 0 15px 35px rgba(255, 178, 0, 0.20);
        border: 1px solid rgba(255, 178, 0, 0.45);
        color: var(--primary);
    }

    .action-btn.delete:hover {
        box-shadow: 0 15px 35px rgba(255, 0, 72, 0.20);
        border: 1px solid rgba(255, 0, 72, 0.45);
        color: var(--danger);
    }

    /* Create new */
    .create-booking-btn {
        display: inline-flex;
        gap: 10px;
        align-items: center;
        padding: 12px 18px;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--primary), var(--primary2));
        color: #140c05;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 20px 50px rgba(255,178,0,0.18);
        transition: 0.25s ease;
        border: none;
    }

    .create-booking-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 25px 60px rgba(255,178,0,0.25);
        color: #140c05;
    }

    .table-responsive {
        border-radius: 20px;
    }
</style>

<div class="nebula-grid"></div>
<div class="orb orb1"></div>
<div class="orb orb2"></div>
<div class="orb orb3"></div>

@if (Model != null && Model.Any())
{
    <div class="container mt-5 mb-5">
        <div class="glass-card">

            <div class="page-title">Rezervasyon Yönetimi</div>
            <div class="page-subtitle">
                Premium panel — rezervasyonlarınızı modern glass UI ilə idarə edin.
            </div>

            <div class="table-responsive">
                <table class="premium-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>İsim</th>
                            <th>Email</th>
                            <th>Giriş Tarihi</th>
                            <th>Çıkış Tarihi</th>
                            <th>Kişi</th>
                            <th>Ülke</th>
                            <th>Oda Türü</th>
                            <th>Mesaj</th>
                            <th>Beklet</th>
                            <th>Onayla</th>
                            <th>Reddet</th>
                            <th style="width:70px;">Edit</th>
                            <th style="width:70px;">Sil</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(count++)</td>
                                <td>@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.CheckIn.ToString("dd-MM-yyyy")</td>
                                <td>@item.CheckOut.ToString("dd-MM-yyyy")</td>
                                <td>@item.Adult</td>
                                <td>@item.Country</td>
                                <td>@item.RoomTypeId</td>

                                <td>
                                    <div class="message-box">
                                        @item.Message
                                    </div>
                                </td>

                                <td>
                                    <button>Beklet</button>
                                   
                                </td>
                                <td>
                                    <button>Onayla</button>
                                   
                                </td>
                                <td>
                                    <button>Reddet</button>
                                   
                                </td>

                                <td>
                                    <a class="action-btn edit"
                                       asp-action="UpdateBooking"
                                       asp-controller="Booking"
                                       asp-route-id="@item.Id"
                                       title="Edit">
                                        <i class="fa fa-pencil"></i>
                                    </a>
                                </td>

                                <td>
                                    <a class="action-btn delete"
                                       asp-action="DeleteBooking"
                                       asp-controller="Booking"
                                       asp-route-id="@item.Id"
                                       title="Delete">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="mt-4">
                <a asp-action="CreateBooking"
                   asp-controller="Booking"
                   class="create-booking-btn">
                    <i class="fa fa-plus"></i> Yeni Rezervasyon Ekle
                </a>
            </div>

        </div>
    </div>
}
else
{
    <div class="container mt-5">
        <div class="glass-card text-center">
            <div class="page-title">Rezervasyon yoxdur</div>
            <div class="page-subtitle">Sistemdə hələ heç bir rezervasyon tapılmadı.</div>

            <a asp-action="CreateBooking"
               asp-controller="Booking"
               class="create-booking-btn mt-3">
                <i class="fa fa-plus"></i> İlk Rezervasyonu Ekle
            </a>
        </div>
    </div>
}

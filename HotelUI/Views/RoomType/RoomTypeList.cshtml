@using DTOs.RoomTypeDTOs
@model List<ResultRoomTypeDto>
@{
    ViewBag.Title = "Room Types";
    ViewBag.BodyClass = "list-theme";
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Sans:wght@300;400;500;600&display=swap');

:root {
    --bg:          #0b0c10;
    --surface:     rgba(255,255,255,0.04);
    --surface2:    rgba(255,255,255,0.07);
    --border:      rgba(255,255,255,0.07);
    --border2:     rgba(255,255,255,0.13);
    --accent:      #7c6af7;
    --accent2:     #a78bfa;
    --accent-glow: rgba(124,106,247,0.28);
    --green:       #22c55e;
    --green-dim:   rgba(34,197,94,0.12);
    --red:         #ef4444;
    --red-dim:     rgba(239,68,68,0.10);
    --text:        #e8eaf0;
    --text2:       #9ca3af;
    --text3:       #6b7280;
    --radius:      18px;
    --radius-sm:   10px;
    --shadow:      0 8px 40px rgba(0,0,0,0.5);
    --font-d:      'Sora', sans-serif;
    --font-b:      'DM Sans', sans-serif;
    --tr:          0.22s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body.list-theme {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-b);
    min-height: 100vh;
    background-image:
        radial-gradient(ellipse 70% 40% at 10% 0%,   rgba(124,106,247,0.13) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 90% 100%,  rgba(124,106,247,0.07) 0%, transparent 60%);
}

/* ─── WRAP ─── */
.wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 44px 28px 72px;
}

/* ─── HERO ─── */
.hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}
.hero h1 {
    font-family: var(--font-d);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #fff 40%, var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
}
.hero p {
    color: var(--text2);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 460px;
}
.hero-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}
.chip {
    padding: 6px 16px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border2);
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--accent2);
    letter-spacing: 0.05em;
    white-space: nowrap;
}

/* ─── GLASS CARD ─── */
.glass-card {
    background: rgba(255,255,255,0.025);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,0.055);
    animation: fadeUp .45s ease both;
}
@@keyframes fadeUp {
    from { opacity:0; transform:translateY(20px); }
    to   { opacity:1; transform:translateY(0); }
}
.card-inner { padding: 28px; }

/* ─── TOOLBAR ─── */
.list-toolbar {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    flex-wrap: wrap;
}
.search-wrap {
    position: relative;
    flex: 1;
    min-width: 220px;
}
.search-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text3);
    font-size: 0.78rem;
    pointer-events: none;
}
.input {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    font-family: var(--font-b);
    font-size: 0.875rem;
    padding: 10px 14px 10px 38px;
    outline: none;
    transition: border-color var(--tr), box-shadow var(--tr), background var(--tr);
}
.input:focus {
    border-color: var(--accent);
    background: rgba(124,106,247,0.06);
    box-shadow: 0 0 0 3px rgba(124,106,247,0.18);
}
.input::placeholder { color: var(--text3); }

.filter-group {
    display: flex;
    gap: 6px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 4px;
}
.filter-btn {
    padding: 5px 16px;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--text2);
    font-family: var(--font-b);
    font-size: 0.78rem;
    font-weight: 500;
    cursor: pointer;
    transition: background var(--tr), color var(--tr), box-shadow var(--tr);
    white-space: nowrap;
}
.filter-btn:hover { color: var(--text); }
.filter-btn.active {
    background: var(--accent);
    color: #fff;
    box-shadow: 0 0 14px var(--accent-glow);
}

/* ─── GRID ─── */
.rt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
}

/* ─── CARD ─── */
.rt-card {
    background: rgba(255,255,255,0.035);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
    animation: cardIn .4s ease both;
    position: relative;
}
.rt-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background: linear-gradient(135deg, rgba(124,106,247,0.06) 0%, transparent 60%);
    opacity: 0;
    transition: opacity var(--tr);
    pointer-events: none;
}
.rt-card:hover {
    transform: translateY(-4px);
    border-color: rgba(124,106,247,0.35);
    box-shadow: 0 16px 48px rgba(0,0,0,0.4), 0 0 0 1px rgba(124,106,247,0.15);
}
.rt-card:hover::before { opacity: 1; }
.rt-card.hidden { display: none; }

@@keyframes cardIn {
    from { opacity:0; transform:translateY(16px) scale(.97); }
    to   { opacity:1; transform:translateY(0)    scale(1); }
}

/* CARD TOP STRIPE */
.card-stripe {
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent2), transparent);
    opacity: 0;
    transition: opacity var(--tr);
}
.rt-card:hover .card-stripe { opacity: 1; }

/* CARD HEAD */
.card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding: 20px 20px 14px;
}
.card-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(124,106,247,0.22), rgba(124,106,247,0.07));
    border: 1px solid rgba(124,106,247,0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent2);
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: transform var(--tr), box-shadow var(--tr);
}
.rt-card:hover .card-icon-wrap {
    transform: scale(1.1) rotate(-4deg);
    box-shadow: 0 0 20px var(--accent-glow);
}
.card-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
}
.card-badge.active-badge {
    background: var(--green-dim);
    border: 1px solid rgba(34,197,94,0.25);
    color: var(--green);
}
.card-badge.inactive-badge {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    color: var(--text3);
}
.dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
}
.active-badge .dot {
    background: var(--green);
    box-shadow: 0 0 5px var(--green);
    animation: blink 2s infinite;
}
.inactive-badge .dot { background: var(--text3); }
@@keyframes blink {
    0%,100% { opacity:1; }
    50%      { opacity:0.3; }
}

/* CARD BODY */
.card-body {
    padding: 0 20px 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.card-title {
    font-family: var(--font-d);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.card-desc {
    font-size: 0.82rem;
    color: var(--text2);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.4em;
}

/* CARD META */
.card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
}
.meta-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    font-size: 0.74rem;
    color: var(--text2);
    font-weight: 500;
}
.meta-pill i { font-size: 0.65rem; color: var(--text3); }
.id-pill {
    font-family: 'Courier New', monospace;
    font-size: 0.7rem;
    color: var(--text3);
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    padding: 3px 8px;
    border-radius: 6px;
}

/* CARD FOOTER */
.card-footer {
    padding: 12px 20px 16px;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 8px;
    align-items: center;
}
.act-btn {
    flex: 1;
    height: 34px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-b);
    text-decoration: none;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: background var(--tr), border-color var(--tr), transform var(--tr), box-shadow var(--tr);
}
.act-edit {
    background: rgba(124,106,247,0.1);
    color: var(--accent2);
    border-color: rgba(124,106,247,0.2);
}
.act-edit:hover {
    background: rgba(124,106,247,0.22);
    border-color: var(--accent);
    box-shadow: 0 4px 14px var(--accent-glow);
    transform: translateY(-1px);
}
.act-delete {
    flex: 0 0 34px;
    background: var(--red-dim);
    color: var(--red);
    border-color: rgba(239,68,68,0.2);
}
.act-delete:hover {
    background: rgba(239,68,68,0.22);
    border-color: var(--red);
    box-shadow: 0 4px 14px rgba(239,68,68,0.2);
    transform: translateY(-1px);
}

/* ─── EMPTY STATE ─── */
.empty-state {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 72px 20px;
    color: var(--text3);
    text-align: center;
}
.empty-state i { font-size: 3rem; opacity: 0.25; }
.empty-state p  { font-size: 0.9rem; }

/* ─── FOOTER ─── */
.list-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 24px;
    flex-wrap: wrap;
    gap: 12px;
}
.hint { font-size: 0.75rem; color: var(--text3); }
.footer-stats { display: flex; gap: 14px; }
.stat-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--text2);
}
.stat-pill strong { color: var(--text); }

/* ─── BUTTONS ─── */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 18px;
    border-radius: var(--radius-sm);
    font-family: var(--font-b);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all var(--tr);
    text-decoration: none;
    white-space: nowrap;
}
.btn-primary {
    background: linear-gradient(135deg, var(--accent), #9b84f8);
    color: #fff;
    box-shadow: 0 2px 16px var(--accent-glow);
}
.btn-primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 28px var(--accent-glow);
    filter: brightness(1.1);
    color: #fff;
    text-decoration: none;
}

/* ─── RESPONSIVE ─── */
@@media (max-width: 640px) {
    .card-inner { padding: 18px 14px; }
    .hero h1    { font-size: 1.4rem; }
    .list-toolbar { flex-direction: column; align-items: stretch; }
    .filter-group { justify-content: center; }
    .rt-grid { grid-template-columns: 1fr; }
}
</style>

<div class="wrap">
    <!-- HERO -->
    <div class="hero">
        <div>
            <h1>Room Type • List</h1>
            <p>Tüm oda tiplerini görüntüle, düzenle veya sil. Canlı arama ve filtre desteklenir.</p>
        </div>
        <div class="hero-right">
            <div class="chip">@(Model?.Count ?? 0) Item</div>
            <a href="/RoomType/CreateRoomType" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Yeni Ekle
            </a>
        </div>
    </div>

    <div class="glass-card">
        <div class="card-inner">

            <!-- TOOLBAR -->
            <div class="list-toolbar">
                <div class="search-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="searchInput" class="input" placeholder="Ara: type veya description..." />
                </div>
                <div class="filter-group">
                    <button class="filter-btn active" data-filter="all">Tümü</button>
                    <button class="filter-btn" data-filter="active">Aktif</button>
                    <button class="filter-btn" data-filter="passive">Pasif</button>
                </div>
            </div>

            <!-- GRID -->
            <div class="rt-grid" id="rtGrid">

                @if (Model != null && Model.Count > 0)
                {
                    int idx = 0;
                    @foreach (var item in Model)
                    {
                        idx++;
                        <div class="rt-card"
                             data-status="@(item.Status ? "active" : "passive")"
                             data-type="@item.Type?.ToLower()"
                             data-desc="@item.Description?.ToLower()"
                             style="animation-delay:@(idx * 55)ms">

                            <div class="card-stripe"></div>

                            <div class="card-head">
                                <div class="card-icon-wrap">
                                    <i class="fa-solid fa-bed"></i>
                                </div>
                                @if (item.Status)
                                {
                                    <div class="card-badge active-badge">
                                        <span class="dot"></span> Aktif
                                    </div>
                                }
                                else
                                {
                                    <div class="card-badge inactive-badge">
                                        <span class="dot"></span> Pasif
                                    </div>
                                }
                            </div>

                            <div class="card-body">
                                <div class="card-title">@item.Type</div>
                                <div class="card-desc">
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "Açıklama girilmemiş." : item.Description)
                                </div>
                                <div class="card-meta">
                                    <span class="id-pill">#@item.Id</span>
                                    <span class="meta-pill">
                                        <i class="fa-solid fa-door-open"></i>
                                       @*  @(item.RoomCount)  *@Oda
                                    </span>
                                </div>
                            </div>

                            <div class="card-footer">
                                <a href="/RoomType/UpdateRoomType/@item.Id" class="act-btn act-edit">
                                    <i class="fa-solid fa-pen"></i> Düzenle
                                </a>
                                <a href="/RoomType/DeleteRoomType/@item.Id"
                                   class="act-btn act-delete"
                                   title="Sil"
                                   onclick="return confirm('Bu oda tipini silmek istediğinize emin misiniz?')">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-bed-pulse"></i>
                        <p>Henüz oda tipi eklenmedi.</p>
                        <a href="/RoomType/CreateRoomType" class="btn btn-primary" style="margin-top:4px;">
                            İlk Kaydı Ekle
                        </a>
                    </div>
                }

            </div>

            <!-- FOOTER -->
            <div class="list-footer">
                <div class="hint" id="resultCount">@(Model?.Count ?? 0) adet kayıt gösteriliyor.</div>
                <div class="footer-stats">
                    <div class="stat-pill">
                        <span class="dot" style="background:#7c6af7;box-shadow:0 0 6px #7c6af7;"></span>
                        Aktif: <strong>@(Model?.Count(x => x.Status) ?? 0)</strong>
                    </div>
                    <div class="stat-pill">
                        <span class="dot" style="background:#6b7280;"></span>
                        Pasif: <strong>@(Model?.Count(x => !x.Status) ?? 0)</strong>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    "use strict";

    const searchInput = document.getElementById("searchInput");
    const filterBtns  = document.querySelectorAll(".filter-btn");
    const cards       = document.querySelectorAll("#rtGrid .rt-card");
    const resultCount = document.getElementById("resultCount");

    let currentFilter = "all";

    /* ── Arama ── */
    searchInput?.addEventListener("input", applyFilters);

    /* ── Filtre ── */
    filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            filterBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            currentFilter = btn.dataset.filter;
            applyFilters();
        });
    });

    function applyFilters() {
        const q = (searchInput?.value || "").toLowerCase().trim();
        let visible = 0;

        cards.forEach(card => {
            const matchSearch = !q ||
                (card.dataset.type || "").includes(q) ||
                (card.dataset.desc || "").includes(q);
            const matchFilter =
                currentFilter === "all" ||
                (currentFilter === "active"  && card.dataset.status === "active") ||
                (currentFilter === "passive" && card.dataset.status === "passive");

            if (matchSearch && matchFilter) {
                card.classList.remove("hidden");
                visible++;
            } else {
                card.classList.add("hidden");
            }
        });

        if (resultCount) resultCount.textContent = `${visible} adet kayıt gösteriliyor.`;

        /* boş mesajı */
        const existing = document.getElementById("noResult");
        if (visible === 0 && cards.length > 0) {
            if (!existing) {
                const el = document.createElement("div");
                el.id = "noResult";
                el.className = "empty-state";
                el.innerHTML = `<i class="fa-solid fa-magnifying-glass"></i>
                                <p>Arama kriterinize uygun kayıt bulunamadı.</p>`;
                document.getElementById("rtGrid").appendChild(el);
            }
        } else if (existing) {
            existing.remove();
        }
    }

    /* ── Kart giriş animasyonu stagger ── */
    cards.forEach((card, i) => {
        card.style.animationDelay = `${i * 55}ms`;
    });

})();
</script>
}

@section Scripts
{
<script>
document.addEventListener("DOMContentLoaded", function(){

    var iconHidden = document.getElementById("Icon");
    var iconOpenBtn = document.getElementById("iconOpenBtn");
    var iconCloseBtn = document.getElementById("iconCloseBtn");
    var iconPop = document.getElementById("iconPop");
    var iconSearch = document.getElementById("iconSearch");
    var iconGrid = document.getElementById("iconGrid");
    var iconButtons = iconGrid ? iconGrid.querySelectorAll(".icon-btn") : [];

    var iconBtnI = document.getElementById("iconBtnI");
    var iconBtnText = document.getElementById("iconBtnText");

    var liveIcon = document.getElementById("liveIcon");
    var rowIcon = document.getElementById("rowIcon");

    var title = document.getElementById("Title");
    var description = document.getElementById("Description");
    var status = document.getElementById("Status");
    var btnReset = document.getElementById("btnReset");

    var liveTitle = document.getElementById("liveTitle");
    var liveDesc = document.getElementById("liveDesc");
    var rowTitle = document.getElementById("rowTitle");
    var rowDesc = document.getElementById("rowDesc");

    var liveBadge = document.getElementById("liveBadge");
    var liveBadgeText = document.getElementById("liveBadgeText");

    function safe(v, fallback){
        fallback = (fallback === undefined) ? "" : fallback;
        v = (v === null || v === undefined) ? "" : String(v);
        v = v.trim();
        return v ? v : fallback;
    }

    function openPop(){
        if (!iconPop) return;
        iconPop.classList.add("open");
        if (iconSearch) iconSearch.focus();
    }
    function closePop(){
        if (!iconPop) return;
        iconPop.classList.remove("open");
        if (iconSearch) iconSearch.value = "";
        for (var i=0;i<iconButtons.length;i++){
            iconButtons[i].style.display = "flex";
        }
    }

    function setIcon(cls){
        cls = safe(cls, "fa-solid fa-hotel");

        if (iconHidden) iconHidden.value = cls;
        if (iconBtnText) iconBtnText.textContent = cls;

        if (iconBtnI) iconBtnI.className = cls;
        if (liveIcon) liveIcon.className = cls;

        if (rowIcon) rowIcon.textContent = cls;

        for (var i=0;i<iconButtons.length;i++){
            var b = iconButtons[i];
            var v = b.getAttribute("data-icon");
            b.classList.toggle("active", v === cls);
        }
    }

    function updateText(){
        var t = safe(title && title.value, "Title") || "Title";
        var d = safe(description && description.value, "Description") || "Description";

        if (liveTitle) liveTitle.textContent = t;
        if (liveDesc) liveDesc.textContent = d;

        if (rowTitle) rowTitle.textContent = safe(title && title.value, "—") || "—";
        if (rowDesc) rowDesc.textContent = safe(description && description.value, "—") || "—";

        var isActive = !!(status && status.checked);
        if (liveBadge){
            liveBadge.classList.toggle("active", isActive);
            liveBadge.classList.toggle("inactive", !isActive);
        }
        if (liveBadgeText) liveBadgeText.textContent = isActive ? "Aktif" : "Pasif";
    }

    if (iconOpenBtn) iconOpenBtn.addEventListener("click", function(){
        if (!iconPop) return;
        iconPop.classList.contains("open") ? closePop() : openPop();
    });
    if (iconCloseBtn) iconCloseBtn.addEventListener("click", closePop);

    document.addEventListener("click", function(e){
        if (!iconPop || !iconOpenBtn) return;
        var inside = iconPop.contains(e.target) || iconOpenBtn.contains(e.target);
        if (!inside) closePop();
    });

    for (var i=0;i<iconButtons.length;i++){
        (function(btn){
            btn.addEventListener("click", function(){
                var cls = btn.getAttribute("data-icon");
                setIcon(cls);
                closePop();
            });
        })(iconButtons[i]);
    }

    if (iconSearch){
        iconSearch.addEventListener("input", function(){
            var q = safe(iconSearch.value, "").toLowerCase();
            for (var i=0;i<iconButtons.length;i++){
                var b = iconButtons[i];
                var t = (b.getAttribute("title") || "").toLowerCase();
                var cls = (b.getAttribute("data-icon") || "").toLowerCase();
                var show = !q || (t.indexOf(q) !== -1) || (cls.indexOf(q) !== -1);
                b.style.display = show ? "flex" : "none";
            }
        });
    }

    if (title) title.addEventListener("input", updateText);
    if (description) description.addEventListener("input", updateText);
    if (status) status.addEventListener("change", updateText);

    if (btnReset){
        btnReset.addEventListener("click", function(){
            setTimeout(function(){
                setIcon("fa-solid fa-hotel");
                closePop();
                updateText();
            }, 0);
        });
    }

    setIcon(iconHidden && iconHidden.value ? iconHidden.value : "fa-solid fa-hotel");
    updateText();
});
</script>
}

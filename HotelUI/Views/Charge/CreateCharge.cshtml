@using DTOs.ChargeDTOs
@model CreateChargeDto

@{
    ViewBag.Title = "Create Charge";
    ViewBag.BodyClass = "create-theme";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/create-theme.css" asp-append-version="true" />

<style>
    /* ==== FIX: uzun metin layout'u daraltmasın ==== */

/* Live header kısmında flex shrink bug fix */
.charge-live-head { min-width: 0; }
.charge-live-text { min-width: 0; flex: 1 1 auto; }

/* Title: kırılabilir + 1-2 satır clamp */
.charge-live-title{
  white-space: normal !important;
  overflow-wrap: anywhere !important;
  word-break: break-word !important;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;   /* 1 satır + ... istersen 2 yap */
  overflow: hidden;
}

/* Desc: kırılabilir + 2 satır clamp */
.charge-live-desc{
  white-space: normal !important;
  overflow-wrap: anywhere !important;
  word-break: break-word !important;
  min-width: 0;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Alttaki live-row satırlarında: değer alanı daralmasın */
.live-row { align-items: flex-start; }
.live-row .k { flex: 0 0 110px; }   /* sol label sabit */
.live-row .v{
  flex: 1 1 auto !important;
  min-width: 0 !important;
  max-width: none !important;       /* sende 70% vardı, o daraltıyordu */
  white-space: normal !important;
  overflow-wrap: anywhere !important;
  word-break: break-word !important;
  text-align: right;
}

/* Description satırında da 2 satır + ... */
.live-row .v.desc{
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ===== ICON PICKER (otel hizmetleri - geniş liste) ===== */
.icon-pick-btn{
    width:100%;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.06);
    color: rgba(255,255,255,.92);
    padding: 12px;
    outline:none;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    cursor:pointer;
    box-shadow: 0 10px 25px rgba(0,0,0,.18);
    transition:.18s ease;
}
.icon-pick-btn:hover{ filter: brightness(1.06); }
.icon-left{ display:flex; align-items:center; gap:10px; min-width:0; }
.icon-badge{
    width:42px; height:42px; border-radius:14px;
    border:1px solid rgba(255,255,255,.15);
    background: rgba(0,0,0,.22);
    display:flex; align-items:center; justify-content:center;
    flex:0 0 auto;
}
.icon-badge i{ font-size:18px !important; color: rgba(255,255,255,.92) !important; }
.icon-meta{ min-width:0; display:flex; flex-direction:column; gap:2px; }
.icon-meta .t1{ font-weight:900; font-size:13px; color:#fff; line-height:1.2; }
.icon-meta .t2{
    font-size:12px; color: rgba(255,255,255,.58);
    overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width: 360px;
}
.icon-caret{ color: rgba(255,255,255,.65); }

.icon-pop{ position:relative; margin-top:10px; display:none; }
.icon-pop.open{ display:block; }

.icon-panel{
    border-radius:18px;
    border:1px solid rgba(255,255,255,.14);
    background: rgba(0,0,0,.35);
    box-shadow: 0 20px 60px rgba(0,0,0,.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow:hidden;
}
.icon-panel-head{
    padding:12px;
    border-bottom:1px solid rgba(255,255,255,.10);
    display:flex; gap:10px; align-items:center;
}
.icon-search{
    flex:1;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.06);
    color: rgba(255,255,255,.92);
    padding:10px 12px;
    outline:none;
    box-shadow: 0 10px 25px rgba(0,0,0,.18);
}
.icon-close{
    border:1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.08);
    color: rgba(255,255,255,.92);
    border-radius:14px;
    padding:10px 12px;
    cursor:pointer;
    font-weight:900;
}
.icon-close:hover{ filter: brightness(1.06); }

.icon-grid{
    padding:12px;
    display:grid;
    grid-template-columns: repeat(10, minmax(0, 1fr)); /* daha geniş */
    gap:10px;
    max-height: 300px;
    overflow:auto;
}
@@media (max-width: 1000px){ .icon-grid{ grid-template-columns: repeat(7, 1fr); } }
@@media (max-width: 760px){ .icon-grid{ grid-template-columns: repeat(5, 1fr); } }
@@media (max-width: 560px){ .icon-grid{ grid-template-columns: repeat(4, 1fr); } }

.icon-btn{
    border: 1px solid rgba(255,255,255,.12);
    background: rgba(255,255,255,.05);
    border-radius: 16px;
    height: 48px;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    transition: transform .12s ease, filter .12s ease, background .12s ease, border-color .12s ease;
    user-select:none;
}
.icon-btn:hover{ filter: brightness(1.06); background: rgba(168,85,247,.10); }
.icon-btn:active{ transform: translateY(1px); }
.icon-btn.active{
    border-color: rgba(168,85,247,.55);
    background: rgba(168,85,247,.16);
    box-shadow: 0 0 0 4px rgba(168,85,247,.10);
}
.icon-btn i{ font-size:18px !important; color: rgba(255,255,255,.92) !important; }

/* ===== LIVE PREVIEW FIX (ikon ortada çirkin durmasın + taşma olmasın) ===== */
.live-icon{
    width: 50px; height: 50px;
    border-radius: 16px;
    border:1px solid rgba(255,255,255,.15);
    background: rgba(0,0,0,.22);
    display:flex; align-items:center; justify-content:center;
    box-shadow: 0 12px 30px rgba(0,0,0,.25);
    flex:0 0 auto;
}
.live-icon i{ font-size:20px !important; color: rgba(255,255,255,.92) !important; }

.live-media .ph{
    display:flex !important;
    align-items:flex-start !important;
    justify-content:flex-start !important;
    text-align:left !important;
    padding:18px !important;
}

.charge-live-head{
    width:100%;
    display:flex;
    align-items:flex-start;
    gap:12px;
}
.charge-live-text{ min-width:0; flex:1; }
.charge-live-title{
    font-weight:950;
    color:#fff;
    font-size:16px;
    line-height:1.2;
    margin:2px 0 6px;
}
.charge-live-desc{
    color:rgba(255,255,255,.70);
    font-size:13px;
    line-height:1.35;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
}

/* alt satırlarda taşma fix */
.live-row .v{
    min-width:0;
    max-width:70%;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}
.live-row .v.desc{
    white-space:normal;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
    text-overflow:ellipsis;
    max-width:70%;
}
</style>


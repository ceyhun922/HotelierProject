@using DTOs.ChargeDTOs
@model GetByIdChargeDto

@{
    Layout ="_Layout";
}

@using(Html.BeginForm("UpdateCharge","Charge",FormMethod.Post))
{
    @Html.HiddenFor(x=>x.Id)
    @Html.TextBoxFor(x=>x.Icon)
    @Html.TextBoxFor(x=>x.Title)
    @Html.TextAreaFor(x=>x.Description)
    @Html.CheckBoxFor(x=>x.Status)
    <button type="submit">Ekle</button>
}
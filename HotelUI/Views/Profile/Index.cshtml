@using DTOs.UserDTOs
@model GetByIdUserDto
@{
    var apiBase = "https://localhost:7243";
    var currentImg = Model.ImageUrl ?? "";
    if (!string.IsNullOrWhiteSpace(currentImg) && currentImg.StartsWith("/images/"))
        currentImg = apiBase + currentImg;
}

<div class="container-fluid mt-3">
    <div class="row">
        <!-- Sol Profil Kartı -->
        <div class="col-lg-4 col-xl-3">
            <!-- Profil Kartı -->
            <div class="card" style="background: radial-gradient(1200px 600px at 10% 10%, rgba(168,85,247,.20), transparent 55%), radial-gradient(900px 520px at 90% 0%, rgba(56,189,248,.14), transparent 55%), linear-gradient(180deg, rgba(7,6,12,.92), rgba(10,8,18,.82)); border-right: 1px solid rgba(255,255,255,.10); box-shadow: 0 30px 90px rgba(0,0,0,.55);">
                <div class="card-body">
                    <div class="media align-items-center mb-4">
                        <img class="mr-3 rounded-circle" src="@currentImg" width="80" height="80" alt="@Model.UserName">
                        <div class="media-body">
                            <h3 class="mb-0">@Model.UserName</h3>
                            <p class="text-muted mb-0">Canada</p>
                        </div>
                    </div>

                    <h4>Hakkımda</h4>
                    <p class="text-muted">
                        Merhaba, ben Pikamy. 1500'lerden beri sektörün standart boş metni.
                    </p>

                    <ul class="card-profile__info">
                        <li class="mb-1">
                            <strong class="text-dark mr-4">Mobil</strong>
                            <span>01793931609</span>
                        </li>
                        <li>
                            <strong class="text-dark mr-4">E-posta</strong>
                            <span>@Model.Email</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Hesap Bilgileri Kartı -->
            <div class="card" style="background: radial-gradient(1200px 600px at 10% 10%, rgba(168,85,247,.20), transparent 55%), radial-gradient(900px 520px at 90% 0%, rgba(56,189,248,.14), transparent 55%), linear-gradient(180deg, rgba(7,6,12,.92), rgba(10,8,18,.82)); border-right: 1px solid rgba(255,255,255,.10); box-shadow: 0 30px 90px rgba(0,0,0,.55);">
                <div class="card-body">
                    <h4 class="mb-3">Hesap Bilgileri</h4>

                    <ul class="card-profile__info">
                        <li class="mb-2">
                            <strong class="text-dark mr-4">Rol</strong>
                            <span class="badge badge-primary">Admin</span>
                        </li>

                        <li class="mb-2">
                            <strong class="text-dark mr-4">Durum</strong>
                            <span class="badge badge-success">Aktif</span>
                        </li>

                        <li class="mb-2">
                            <strong class="text-dark mr-4">Oluşturulma Tarihi</strong>
                            <span>02 Şub 2026</span>
                        </li>

                        <li class="mb-2">
                            <strong class="text-dark mr-4">Son Giriş</strong>
                            <span>Bugün 14:22</span>
                        </li>

                        <li class="mb-2">
                            <strong class="text-dark mr-4">Doğrulama</strong>
                            <span class="badge badge-warning">Beklemede</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Sağ Profil Düzenleme -->
        <div class="col-lg-8 col-xl-9">
            <!-- Profil Düzenleme -->
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Profil Düzenle</h4>
                </div>

                <div class="card-body">
                    @using (Html.BeginForm("Index", "Profile", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        <div class="row">
                            @Html.HiddenFor(x => x.Id)

                            <!-- Profil Fotoğrafı -->
                            <div class="col-md-12 mb-4">
                                <label class="font-weight-bold">Profil Fotoğrafı</label>
                                <div class="d-flex align-items-center">
                                    <img src="images/avatar/11.png" class="rounded-circle mr-3" width="80" height="80" alt="">
                                    <div style="width: 100%;">
                                        <input type="file" class="form-control" />
                                        <small class="text-muted">PNG / JPG format desteklenmektedir.</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Kullanıcı Adı -->
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(x => x.UserName, new { @class = "font-weight-bold" })
                                @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", placeholder = "Kullanıcı adı girin" })
                            </div>

                            <!-- E-posta -->
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(x => x.Email, new { @class = "font-weight-bold" })
                                @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "E-posta girin" })
                            </div>

                            <!-- Hakkında -->
                            <div class="col-md-12 mb-3">
                                <label class="font-weight-bold">Hakkımda</label>
                                <textarea class="form-control" rows="4" placeholder="Hakkında yaz...">Merhaba, ben Pikamy. 1500'lerden beri sektörün standart boş metni.</textarea>
                            </div>

                            <!-- Kaydet Butonu -->
                            <div class="col-md-12 text-right">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="fa fa-save mr-1"></i> Değişiklikleri Kaydet
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Şifre Değiştirme -->
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Şifreyi Değiştir</h4>
                </div>

                <div class="card-body">
                    <form>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold">Yeni Şifre</label>
                                <input type="password" class="form-control" placeholder="Yeni şifre girin">
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="font-weight-bold">Yeni Şifre (Tekrar)</label>
                                <input type="password" class="form-control" placeholder="Tekrar girin">
                            </div>

                            <div class="col-md-12 text-right">
                                <button type="submit" class="btn btn-danger px-4">
                                    <i class="fa fa-lock mr-1"></i> Şifreyi Değiştir
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

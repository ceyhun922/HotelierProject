@using DTOs.ContactDTOs
@model List<ResultContactDto>
@{
    Layout = "_Layout";
    var count =1;
    var first =Model.FirstOrDefault();
}



<div class="card">
    <div class="card-body">

        <h4 class="card-title">Oda Tipi Ekleme</h4>
        <div class="table-responsive">
            <table class="table table-bordered table-striped verticle-middle">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Type</th>
                        <th scope="col">Description</th>
                        <th scope="col">Durum</th>
                        <th scope="col">Edit</th>
                        <th scope="col">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(count++)</td>
                            <td>@item.MailBooking</td>
                            <td>@item.MailGeneral</td>
                            <td>@item.MailTechnical</td>
                            <td>@item.MapLocation</td>
                             <td>
                                @(item.Status ? "Aktif" : "Pasif")
                            <td>
                                <span>
                                    <a asp-action="UpdateContact" asp-controller="Contact" asp-route-id="@item.Id" data-toggle="tooltip" data-placement="top" title="Edit">
                                        <i class="fa fa-pencil color-muted m-r-5"></i>
                                    </a>
                                    
                                </span>
                            </td>
                            <td>
                                <span>
                                <a asp-action="DeleteContact" asp-controller="Contact" asp-route-id="@item.Id" data-toggle="tooltip" data-placement="top" title="Delete">
                                        <i class="fa fa-close color-danger"></i>
                                    </a>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if(first != null)
        {
        <h4 class="card-title"><a asp-action="CreateContact" asp-controller="Contact"> Alan Var</a></h4>

        }else {
                    <h4 class="card-title"><a asp-action="CreateContact" asp-controller="Contact"> + Yeni İletişim Alanı Etke</a></h4>

        }

    </div>
</div>
@using DTOs.ContactDTOs
@model GetByIdContactDto

@using(Html.BeginForm("UpdateContact","Contact",FormMethod.Post))
{
    @Html.HiddenFor(x=>x.Id)
    @Html.TextBoxFor(x=>x.MailBooking)
    @Html.TextBoxFor(x=>x.MailGeneral)
    @Html.TextBoxFor(x=>x.MailTechnical)
    @Html.TextBoxFor(x=>x.MapLocation)
    @Html.CheckBoxFor(x=>x.Status)
    <button type="submit">Ekle</button>
}
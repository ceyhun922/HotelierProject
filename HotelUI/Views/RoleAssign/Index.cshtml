@using DTOs.UserDTOs
@model List<ResultUserDto>
<div class="container">
    <div class="row">
        <div class="col-12">
            <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kullanıcılar</th>
                            <th>Atama Yap</th>
                        </tr>
                      
                    </thead>
                    <tbody>
                        @foreach(var user in Model)
                        {
                        <tr>
                            <td>@user.Id</td>
                            <td>@user.UserName</td>
                           <td> <a class="btn btn-success" asp-controller="RoleAssign" asp-action="RoleAuthority" asp-route-id="@user.Id">Role Ata</a></td>
                        </tr>
                       }
                    </tbody>
            </table>
        </div>
    </div>
</div>
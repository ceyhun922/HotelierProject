@using DTOs.GuestDTOs
@model List<ResultGuestDto>
@{
    Layout = "_Layout";
    ViewBag.Title = "Guests";
    ViewBag.BodyClass = "list-theme";

    var avatarColors = new[] {
        ("#7c6af7","rgba(124,106,247,0.2)"),
        ("#06b6d4","rgba(6,182,212,0.2)"),
        ("#10b981","rgba(16,185,129,0.2)"),
        ("#f59e0b","rgba(245,158,11,0.2)"),
        ("#ec4899","rgba(236,72,153,0.2)"),
        ("#8b5cf6","rgba(139,92,246,0.2)"),
        ("#f97316","rgba(249,115,22,0.2)"),
        ("#14b8a6","rgba(20,184,166,0.2)"),
    };
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap');

:root {
    --bg:          #0b0c10;
    --surface:     rgba(255,255,255,0.04);
    --border:      rgba(255,255,255,0.07);
    --border2:     rgba(255,255,255,0.13);
    --accent:      #7c6af7;
    --accent2:     #a78bfa;
    --accent-glow: rgba(124,106,247,0.28);
    --red:         #ef4444;
    --red-dim:     rgba(239,68,68,0.10);
    --text:        #e8eaf0;
    --text2:       #9ca3af;
    --text3:       #6b7280;
    --radius:      20px;
    --radius-sm:   10px;
    --shadow:      0 8px 40px rgba(0,0,0,0.5);
    --font-d:      'Sora', sans-serif;
    --font-b:      'DM Sans', sans-serif;
    --tr:          0.24s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body.list-theme {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-b);
    min-height: 100vh;
    background-image:
        radial-gradient(ellipse 70% 40% at 10% 0%,  rgba(124,106,247,0.13) 0%, transparent 60%),
        radial-gradient(ellipse 50% 35% at 90% 100%, rgba(124,106,247,0.07) 0%, transparent 60%);
}

.wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 44px 28px 80px;
}

/* ─── HERO ─── */
.hero {
    display: flex; align-items: flex-start;
    justify-content: space-between;
    gap: 20px; margin-bottom: 36px; flex-wrap: wrap;
}
.hero h1 {
    font-family: var(--font-d);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    font-weight: 800; letter-spacing: -0.04em;
    background: linear-gradient(135deg, #fff 30%, var(--accent2));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
}
.hero p { color: var(--text2); font-size: .875rem; line-height: 1.65; max-width: 460px; }
.hero-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.chip {
    padding: 6px 16px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border2);
    font-size: .74rem; font-weight: 600;
    color: var(--accent2); letter-spacing: .05em; white-space: nowrap;
}

/* ─── GLASS WRAP ─── */
.glass-card {
    background: rgba(255,255,255,0.025);
    backdrop-filter: blur(24px) saturate(1.6);
    -webkit-backdrop-filter: blur(24px) saturate(1.6);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,0.05);
    animation: fadeUp .5s ease both;
    overflow: hidden;
}
@@keyframes fadeUp {
    from { opacity:0; transform:translateY(22px); }
    to   { opacity:1; transform:translateY(0); }
}
.card-inner { padding: 30px; }

/* ─── TOOLBAR ─── */
.list-toolbar {
    display: flex; align-items: center;
    gap: 14px; margin-bottom: 28px; flex-wrap: wrap;
}
.search-wrap { position: relative; flex: 1; min-width: 220px; }
.search-icon {
    position: absolute; left: 14px; top: 50%;
    transform: translateY(-50%);
    color: var(--text3); font-size: .78rem; pointer-events: none;
}
.input {
    width: 100%;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text); font-family: var(--font-b); font-size: .875rem;
    padding: 11px 14px 11px 40px; outline: none;
    transition: border-color var(--tr), box-shadow var(--tr), background var(--tr);
}
.input:focus {
    border-color: var(--accent);
    background: rgba(124,106,247,0.06);
    box-shadow: 0 0 0 3px rgba(124,106,247,0.18);
}
.input::placeholder { color: var(--text3); }

.filter-group {
    display: flex; gap: 6px;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 999px; padding: 4px;
}
.filter-btn {
    padding: 5px 16px; border-radius: 999px; border: none;
    background: transparent; color: var(--text2);
    font-family: var(--font-b); font-size: .78rem; font-weight: 500;
    cursor: pointer;
    transition: background var(--tr), color var(--tr), box-shadow var(--tr);
    white-space: nowrap;
}
.filter-btn:hover { color: var(--text); }
.filter-btn.active { background: var(--accent); color: #fff; box-shadow: 0 0 14px var(--accent-glow); }

/* ─── GRID ─── */
.guest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
}

/* ─── GUEST CARD ─── */
.guest-card {
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    background: rgba(255,255,255,0.03);
    position: relative;
    transition: transform var(--tr), box-shadow var(--tr), border-color var(--tr);
    animation: cardIn .45s ease both;
    cursor: default;
}
.guest-card::before {
    content: '';
    position: absolute; inset: 0; border-radius: var(--radius);
    background: linear-gradient(135deg, var(--c-dim) 0%, transparent 60%);
    opacity: 0; transition: opacity var(--tr); pointer-events: none;
}
.guest-card:hover {
    transform: translateY(-5px);
    border-color: var(--c-main);
    box-shadow: 0 20px 52px rgba(0,0,0,0.4), 0 0 32px var(--c-dim);
}
.guest-card:hover::before { opacity: 1; }
.guest-card.hidden { display: none; }

@@keyframes cardIn {
    from { opacity:0; transform:translateY(18px) scale(.97); }
    to   { opacity:1; transform:translateY(0) scale(1); }
}

/* ── CARD TOP BANNER ── */
.card-banner {
    height: 72px;
    position: relative;
    background: linear-gradient(135deg, var(--c-dim), transparent 80%);
    overflow: hidden;
    flex-shrink: 0;
}
.card-banner::after {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 80% 120% at 20% 50%, var(--c-dim) 0%, transparent 70%);
}
/* dekoratif büyük harf arka planda */
.banner-letter {
    position: absolute;
    right: -8px; bottom: -20px;
    font-family: var(--font-d);
    font-size: 7rem; font-weight: 800;
    color: var(--c-main);
    opacity: .07;
    line-height: 1;
    user-select: none;
    pointer-events: none;
    letter-spacing: -.04em;
}
/* id pill */
.banner-id {
    position: absolute; top: 10px; right: 12px;
    padding: 3px 9px; border-radius: 6px;
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.08);
    font-size: .67rem; font-weight: 600; color: rgba(255,255,255,.45);
    font-family: 'Courier New', monospace;
}

/* ── AVATAR ── */
.avatar-wrap {
    display: flex;
    justify-content: flex-start;
    padding: 0 20px;
    margin-top: -28px;
    position: relative;
    z-index: 2;
}
.avatar {
    width: 56px; height: 56px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--c-main), var(--c-dim));
    border: 3px solid var(--bg);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 1.3rem; font-weight: 700;
    color: #fff;
    box-shadow: 0 0 0 1px var(--c-main), 0 4px 16px var(--c-dim);
    transition: transform var(--tr), box-shadow var(--tr);
    flex-shrink: 0;
    text-transform: uppercase;
}
.guest-card:hover .avatar {
    transform: scale(1.08);
    box-shadow: 0 0 0 2px var(--c-main), 0 6px 24px var(--c-dim);
}

/* ── CARD BODY ── */
.card-body {
    padding: 12px 20px 16px;
    flex: 1; display: flex; flex-direction: column; gap: 10px;
}
.guest-name {
    font-family: var(--font-d);
    font-size: 1rem; font-weight: 700;
    color: var(--text); letter-spacing: -.01em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* info rows */
.info-row {
    display: flex; align-items: center; gap: 9px;
    padding: 7px 10px;
    border-radius: 8px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.05);
    transition: background var(--tr), border-color var(--tr);
}
.guest-card:hover .info-row {
    background: rgba(255,255,255,0.055);
    border-color: rgba(255,255,255,0.09);
}
.info-row i {
    font-size: .72rem; color: var(--c-main); width: 14px; text-align: center; flex-shrink: 0;
}
.info-row span {
    font-size: .79rem; color: var(--text2);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* country pill */
.country-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 10px; border-radius: 999px;
    background: var(--c-dim);
    border: 1px solid var(--c-main);
    font-size: .72rem; font-weight: 600;
    color: var(--c-main);
    width: fit-content;
    transition: box-shadow var(--tr);
}
.guest-card:hover .country-pill {
    box-shadow: 0 0 10px var(--c-dim);
}

/* ── CARD FOOTER ── */
.card-footer {
    padding: 10px 16px 14px;
    border-top: 1px solid var(--border);
    display: flex; gap: 8px;
}
.act-btn {
    flex: 1; height: 34px; border-radius: 9px;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    font-size: .78rem; font-weight: 600; font-family: var(--font-b);
    text-decoration: none; border: 1px solid var(--border);
    cursor: pointer; transition: all var(--tr);
}
.act-detail {
    background: rgba(255,255,255,0.04);
    color: var(--c-main);
    border-color: rgba(255,255,255,0.08);
}
.act-detail:hover {
    background: var(--c-dim);
    border-color: var(--c-main);
    box-shadow: 0 4px 16px var(--c-dim);
    transform: translateY(-1px);
}
.act-mail {
    flex: 0 0 34px;
    background: rgba(255,255,255,0.03);
    color: var(--text2);
    border-color: rgba(255,255,255,0.07);
}
.act-mail:hover {
    background: rgba(255,255,255,0.08);
    color: var(--text);
    transform: translateY(-1px);
}

/* ─── EMPTY ─── */
.empty-state {
    grid-column: 1/-1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 14px; padding: 80px 20px;
    color: var(--text3); text-align: center;
}
.empty-state i { font-size: 3.5rem; opacity: .18; }
.empty-state p  { font-size: .92rem; }

/* ─── FOOTER ─── */
.list-footer {
    display: flex; align-items: center; justify-content: space-between;
    margin-top: 26px; flex-wrap: wrap; gap: 12px;
}
.hint { font-size: .75rem; color: var(--text3); }
.footer-stats { display: flex; gap: 14px; }
.stat-pill { display: flex; align-items: center; gap: 6px; font-size: .78rem; color: var(--text2); }
.stat-pill strong { color: var(--text); }

/* ─── BUTTONS ─── */
.btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 10px 20px; border-radius: var(--radius-sm);
    font-family: var(--font-b); font-size: .85rem; font-weight: 600;
    cursor: pointer; border: none; transition: all var(--tr);
    text-decoration: none; white-space: nowrap;
}
.btn-primary {
    background: linear-gradient(135deg, var(--accent), #9b84f8);
    color: #fff; box-shadow: 0 2px 16px var(--accent-glow);
}
.btn-primary:hover {
    transform: translateY(-1px); box-shadow: 0 6px 28px var(--accent-glow);
    filter: brightness(1.1); color: #fff; text-decoration: none;
}

@@media (max-width: 640px) {
    .card-inner { padding: 18px 14px; }
    .hero h1    { font-size: 1.4rem; }
    .list-toolbar { flex-direction: column; align-items: stretch; }
    .filter-group { justify-content: center; }
    .guest-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
}
@@media (max-width: 420px) {
    .guest-grid { grid-template-columns: 1fr; }
}
</style>

<div class="wrap">

    <!-- HERO -->
    <div class="hero">
        <div>
            <h1>Guest • List</h1>
            <p>Tüm misafirleri görüntüle. Canlı arama ve ülke filtresi desteklenir.</p>
        </div>
        <div class="hero-right">
            <div class="chip">@(Model?.Count ?? 0) Misafir</div>
        </div>
    </div>

    <div class="glass-card">
        <div class="card-inner">

            <!-- TOOLBAR -->
            <div class="list-toolbar">
                <div class="search-wrap">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="searchInput" class="input" placeholder="İsim, email veya ülke ara..." />
                </div>
                <div class="filter-group" id="countryFilters">
                    <button class="filter-btn active" data-filter="all">Tümü</button>
                    @if (Model != null)
                    {
                        @foreach (var country in Model.Where(x => !string.IsNullOrEmpty(x.Country))
                                                       .Select(x => x.Country!)
                                                       .Distinct()
                                                       .OrderBy(x => x)
                                                       .Take(5))
                        {
                            <button class="filter-btn" data-filter="@country.ToLower()">@country</button>
                        }
                    }
                </div>
            </div>

            <!-- GRID -->
            <div class="guest-grid" id="guestGrid">

                @if (Model != null && Model.Count > 0)
                {
                    int idx = 0;
                    @foreach (var item in Model)
                    {
                        var (cMain, cDim) = avatarColors[idx % avatarColors.Length];
                        idx++;

                        var initials = string.Join("",
                            (item.FullName ?? "?")
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(w => w[0]));

                        var firstLetter = (item.FullName ?? "?")[0].ToString().ToUpper();

                        <div class="guest-card"
                             data-name="@item.FullName?.ToLower()"
                             data-email="@item.Email?.ToLower()"
                             data-country="@item.Country?.ToLower()"
                             style="--c-main:@cMain; --c-dim:@cDim; animation-delay:@(idx * 55)ms">

                            <!-- BANNER -->
                            <div class="card-banner">
                                <span class="banner-letter">@firstLetter</span>
                                <span class="banner-id">#@item.Id</span>
                            </div>

                            <!-- AVATAR -->
                            <div class="avatar-wrap">
                                <div class="avatar">@initials</div>
                            </div>

                            <!-- BODY -->
                            <div class="card-body">
                                <div class="guest-name">@(item.FullName ?? "—")</div>

                                <div class="info-row">
                                    <i class="fa-solid fa-envelope"></i>
                                    <span title="@item.Email">@(item.Email ?? "—")</span>
                                </div>

                                @if (!string.IsNullOrEmpty(item.Country))
                                {
                                    <div class="country-pill">
                                        <i class="fa-solid fa-earth-europe" style="font-size:.65rem;"></i>
                                        @item.Country
                                    </div>
                                }
                            </div>

                            <!-- FOOTER -->
                            <div class="card-footer">
                                <div class="act-btn act-detail">
                                    <i class="fa-solid fa-user"></i> Detay
                                </div>
                                <a href="mailto:@item.Email" class="act-btn act-mail" title="E-posta gönder">
                                    <i class="fa-solid fa-paper-plane"></i>
                                </a>
                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fa-solid fa-users"></i>
                        <p>Henüz misafir kaydı bulunmuyor.</p>
                    </div>
                }

            </div>

            <!-- LIST FOOTER -->
            <div class="list-footer">
                <div class="hint" id="resultCount">@(Model?.Count ?? 0) misafir gösteriliyor.</div>
                <div class="footer-stats">
                    <div class="stat-pill">
                        <i class="fa-solid fa-earth-europe" style="color:#7c6af7;font-size:.7rem;"></i>
                        Ülke: <strong>@(Model?.Where(x => !string.IsNullOrEmpty(x.Country)).Select(x => x.Country).Distinct().Count() ?? 0)</strong>
                    </div>
                    <div class="stat-pill">
                        <i class="fa-solid fa-users" style="color:#06b6d4;font-size:.7rem;"></i>
                        Toplam: <strong>@(Model?.Count ?? 0)</strong>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
(function () {
    "use strict";

    const searchInput  = document.getElementById("searchInput");
    const cards        = document.querySelectorAll("#guestGrid .guest-card");
    const filterBtns   = document.querySelectorAll("#countryFilters .filter-btn");
    const resultCount  = document.getElementById("resultCount");

    let currentFilter = "all";

    searchInput?.addEventListener("input", apply);

    filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            filterBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            currentFilter = btn.dataset.filter;
            apply();
        });
    });

    function apply() {
        const q = (searchInput?.value || "").toLowerCase().trim();
        let visible = 0;

        cards.forEach(card => {
            const matchSearch =
                !q ||
                (card.dataset.name    || "").includes(q) ||
                (card.dataset.email   || "").includes(q) ||
                (card.dataset.country || "").includes(q);

            const matchFilter =
                currentFilter === "all" ||
                (card.dataset.country || "") === currentFilter;

            const show = matchSearch && matchFilter;
            card.classList.toggle("hidden", !show);
            if (show) visible++;
        });

        if (resultCount) resultCount.textContent = `${visible} misafir gösteriliyor.`;

        const ex = document.getElementById("noResult");
        if (visible === 0 && cards.length > 0) {
            if (!ex) {
                const el = document.createElement("div");
                el.id = "noResult";
                el.className = "empty-state";
                el.style.gridColumn = "1/-1";
                el.innerHTML = `<i class="fa-solid fa-magnifying-glass"></i>
                                <p>Arama kriterinize uygun misafir bulunamadı.</p>`;
                document.getElementById("guestGrid").appendChild(el);
            }
        } else if (ex) { ex.remove(); }
    }

})();
</script>
